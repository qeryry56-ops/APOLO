rules_version = '2';

// Apolo.ma Cloud Firestore Security Rules (Project: apolo-chat-e3ccf)
// The client does not use Firebase Auth yet, so these rules validate structure
// (ID formats, required fields, immutable sender/participants, size limits)
// and deny unknown collections. Real per-user isolation requires Firebase Auth
// custom tokens minted by the Laravel backend.

service cloud.firestore {
  match /databases/{database}/documents {

    function isUid(v) {
      return v is string && v.size() >= 1 && v.size() <= 32 && v.matches('^[0-9]+$');
    }

    function smallStr(v, max) {
      return v is string && v.size() <= max;
    }

    // conversations/{ad_<adId>_u_<a>_<b> | dm_u_<a>_<b>}
    match /conversations/{conversationId} {
      allow get, list: if true;

      allow create: if conversationId.matches('^(ad_[0-9]+_u_[0-9]+_[0-9]+|dm_u_[0-9]+_[0-9]+)$')
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && isUid(request.resource.data.participants[0])
        && isUid(request.resource.data.participants[1]);

      allow update: if !('participants' in resource.data)
        || request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if true;

        allow create: if isUid(request.resource.data.sender_id)
          && (!('body' in request.resource.data) || smallStr(request.resource.data.body, 4000))
          && (!('image_base64' in request.resource.data) || smallStr(request.resource.data.image_base64, 1000000))
          && (!('audio_base64' in request.resource.data) || smallStr(request.resource.data.audio_base64, 1000000));

        // edits, delete-for-everyone, reactions, pin, star, read receipts
        allow update: if request.resource.data.sender_id == resource.data.sender_id
          && (!('body' in request.resource.data) || smallStr(request.resource.data.body, 4000));

        allow delete: if false;
      }
    }

    // calls/{autoId} — WebRTC signaling
    match /calls/{callId} {
      allow get, list: if true;

      allow create: if isUid(request.resource.data.caller_id)
        && isUid(request.resource.data.callee_id)
        && request.resource.data.caller_id != request.resource.data.callee_id
        && request.resource.data.status == 'ringing'
        && smallStr(request.resource.data.offer, 200000);

      allow update: if request.resource.data.caller_id == resource.data.caller_id
        && request.resource.data.callee_id == resource.data.callee_id
        && smallStr(request.resource.data.status, 32);

      allow delete: if false;

      match /{sub}/{candidateId} {
        allow get, list: if sub in ['caller_candidates', 'callee_candidates'];
        allow create: if sub in ['caller_candidates', 'callee_candidates']
          && smallStr(request.resource.data.candidate, 10000);
        allow update, delete: if false;
      }
    }

    // reports/{autoId} — write-only from clients
    match /reports/{reportId} {
      allow create: if isUid(request.resource.data.reporter_id)
        && smallStr(request.resource.data.reason, 500)
        && (!('details' in request.resource.data) || smallStr(request.resource.data.details, 4000))
        && request.resource.data.status == 'pending';
      allow get, list, update, delete: if false;
    }

    // user_blocks/{userId}
    match /user_blocks/{userId} {
      allow get: if isUid(userId);
      allow create, update: if isUid(userId);
      allow list, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
