{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "apolo_mobile/build/web",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/apolo-media/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox; default-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(canvaskit|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(flutter_bootstrap.js|flutter.js|main.dart.js|manifest.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://apolo.ma/api/v1/:path*"
    },
    {
      "source": "/apolo-staging-api/:path*",
      "destination": "https://staging.apolo.ma/api/v1/:path*"
    },
    {
      "source": "/apolo-media/:path*",
      "destination": "https://apolo.ma/storage/:path*"
    },
    {
      "source": "/apolo-assets/:path*",
      "destination": "https://apolo.ma/assets/:path*"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/delete-account.html",
      "destination": "/delete-account.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
